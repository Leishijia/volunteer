#!/bin/sh
# 提交前拦一道：交付物自洽性校验。
#
# 启用（克隆后执行一次，因为 .git/hooks 不入库）：
#     git config core.hooksPath .githooks
#
# 临时跳过（只影响本地这一次，CI 不认这个开关）：
#     SKIP_HARNESS=1 git commit -m "..."
#
# 判据与 CI 完全一致：都只调 src/harness.py，不在这里重写任何规则。

set -u

if [ "${SKIP_HARNESS:-0}" = "1" ]; then
    echo "[harness] SKIP_HARNESS=1，跳过校验"
    exit 0
fi

# 跑一条命令（候选解释器可能带参数，如 "py -3.11"，所以整串交给 sh 展开）。
# 全部参数都写死在本文件里，不接受外部输入，因此这里用 sh -c 是安全的。
run_py() { sh -c "$1 src/harness.py --no-write" 2>&1; }
has_dep() { sh -c "$1 -c 'import yaml'" >/dev/null 2>&1; }

# 找一个**装了依赖**的解释器。
# 只判断命令存在是不够的：同一台机器上常有多个 Python（系统版、托管版、
# Windows 的 py 启动器还会默认挑最新的那个），只有其中一个装过 requirements.txt。
# 选错就会以"缺依赖"的形式挡住提交，而被挡的人往往看不出问题出在解释器选择上。
PY=""
for cand in "python3" "python" "py -3.11" "py -3" "py"; do
    if has_dep "$cand"; then
        PY="$cand"
        break
    fi
done

# 一个都没有：退回"随便哪个 Python"，让 harness 自己报 DEPENDENCY_MISSING。
# 那条消息里写了该执行什么命令，比在这里猜更准确。
if [ -z "$PY" ]; then
    for cand in "python3" "python" "py"; do
        if sh -c "$cand --version" >/dev/null 2>&1; then
            PY="$cand"
            break
        fi
    done
fi

if [ -z "$PY" ]; then
    echo "[harness] 未找到 Python，跳过本地校验（CI 仍会跑）" >&2
    exit 0
fi

set +e
out=$(run_py "$PY")
code=$?
set -e

if [ "$code" -eq 0 ]; then
    echo "[harness] 交付物校验通过"
    exit 0
fi

echo "$out" >&2
echo "" >&2

# 退出码 2 = 环境/配置问题（没装 PyYAML、config.yaml 缺失、找不到必要文件）。
# 这和"交付物不合格"是两回事，不能都说成"校验未通过"——
# 那会让人去改文档，而真正要改的是环境。
if [ "$code" -eq 2 ]; then
    echo "[harness] 环境或配置有问题，校验没跑完，提交已中止。" >&2
    echo "  最常见的原因是解释器没装依赖：pip install -r requirements.txt" >&2
    echo "  确认环境无误仍要提交：SKIP_HARNESS=1 git commit ..." >&2
else
    echo "[harness] 校验未通过，提交已中止。" >&2
    echo "  修完再提交；确实要跳过这一次：SKIP_HARNESS=1 git commit ..." >&2
fi
exit 1
