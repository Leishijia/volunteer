#!/bin/sh
# 提交前拦一道：交付物自洽性校验。
#
# 启用（克隆后执行一次，因为 .git/hooks 不入库）：
#     git config core.hooksPath .githooks
#
# 临时跳过（只影响本地这一次，CI 不认这个开关）：
#     SKIP_HARNESS=1 git commit -m "..."
#
# 判据与 CI 完全一致：都只调 src/harness.py，不在这里重写任何规则。

set -u

if [ "${SKIP_HARNESS:-0}" = "1" ]; then
    echo "[harness] SKIP_HARNESS=1，跳过校验"
    exit 0
fi

# 找一个能用的解释器：Linux/macOS 上通常是 python3，Windows 上是 python 或 py
PY=""
for cand in python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done
if [ -z "$PY" ] && command -v py >/dev/null 2>&1; then
    PY="py"
fi

if [ -z "$PY" ]; then
    echo "[harness] 未找到 Python，跳过本地校验（CI 仍会跑）" >&2
    exit 0
fi

if out=$("$PY" src/harness.py --no-write 2>&1); then
    echo "[harness] 交付物校验通过"
    exit 0
fi

echo "$out" >&2
echo "" >&2
echo "[harness] 校验未通过，提交已中止。" >&2
echo "  修完再提交；确实要跳过这一次：SKIP_HARNESS=1 git commit ..." >&2
exit 1
